# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-uuid-here"
NEXTAUTH_URL="http://localhost:3000"

# Gemini AI
GEMINI_API_KEY="your_gemini_api_key"

# Voice Assistant — Text-to-Speech (REQUIRED for a natural voice)
# Without this key the assistant falls back to the browser's built-in
# (robotic) voice. With it, the app uses Google's most human-sounding
# Chirp3-HD voices, stepping down to Neural2/Wavenet if a voice is
# unavailable in your region.
# Setup: Google Cloud Console → enable "Cloud Text-to-Speech API" →
#        Credentials → Create credentials → API key. Free tier ~1M chars/mo.
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here
# Optional: pin a specific voice. Leave unset to use the Chirp3-HD ladder.
# Examples: en-IN-Chirp3-HD-Achernar, en-US-Chirp3-HD-Aoede, en-IN-Neural2-A
# TTS_VOICE=en-IN-Chirp3-HD-Achernar

# Finance Hub (Optional)
GROWW_API_KEY=your_groww_key_here
GROWW_API_SECRET=your_groww_secret_here

# Weather Intelligence
WEATHER_API_KEY=your_weatherapi_key_here

# Zomato Intelligence Hub (Optional)
ZOMATO_CLIENT_ID=your_client_id_here
ZOMATO_CLIENT_SECRET=your_client_secret_here
